# --- FeedDigest environment ---
# Copy this file to `.env` and fill in your keys.
# The app runs fully on bundled mock data when these are empty, so you can
# develop the UI before adding any credentials.

# ===== Gemini (AI summary) =====
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash if left blank.
GEMINI_MODEL=gemini-2.5-flash

# ===== Reddit =====
# Create an "installed app" at https://www.reddit.com/prefs/apps to get a
# client id (installed apps have NO secret). With this set, the app uses the
# authenticated oauth.reddit.com endpoints.
REDDIT_CLIENT_ID=
# Reddit requires a descriptive User-Agent: platform:appid:version (by /u/you)
REDDIT_USER_AGENT=android:com.feeddigest.app:1.0.0 (by /u/your_username)
# Set to "true" to use the public *.json endpoints without a client id.
# (Datacenter IPs may be rate-limited by Reddit.)
REDDIT_USE_PUBLIC=false
